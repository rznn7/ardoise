{
  "name": "ardoise",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ardoise/shared build && concurrently -n shared,front,back -c green,yellow,blue \"pnpm --filter @ardoise/shared dev\" \"pnpm dev:front\" \"pnpm dev:back\"",
    "dev:front": "pnpm --filter @ardoise/frontend dev",
    "dev:back": "pnpm --filter @ardoise/backend dev",
    "build": "pnpm -r build",
    "build:front": "pnpm --filter @ardoise/frontend... build",
    "build:back": "pnpm --filter @ardoise/backend... build",
    "typecheck": "pnpm -r --parallel --if-present typecheck",
    "lint": "pnpm -r --parallel --if-present lint",
    "format": "pnpm -r --if-present format",
    "test": "pnpm -r --if-present test",
    "test:cov": "pnpm -r --if-present test:cov",
    "test:e2e": "pnpm -r --workspace-concurrency=1 --if-present test:e2e",
    "test:watch:front": "pnpm --filter @ardoise/frontend test:watch",
    "test:watch:back": "pnpm --filter @ardoise/backend test:watch",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}

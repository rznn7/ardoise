:80 {
	handle_path /api/* {
		reverse_proxy ardoise-backend:3000
	}

	handle /version.json {
		header Cache-Control no-store
		root * /srv
		file_server
	}

	handle {
		@mutable not path_regexp -[A-Za-z0-9_-]{8}\.(js|css)$
		header @mutable Cache-Control no-cache
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

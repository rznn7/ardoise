{
  "name": "@ardoise/frontend",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "format": "eslint src scripts --fix && prettier --write \"src/**/*.{ts,html}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:cov": "ng test --watch=false --coverage",
    "lint": "eslint src scripts",
    "backdrops": "tsx scripts/backdrops/generate.mts"
  },
